# Image de l'interface Streamlit : client HTTP léger de l'API, sans PyTorch ni modèle.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    PORT=8501

WORKDIR /app

# Seules les dépendances importées par l'interface (extra `ui` + Pillow) : le paquet complet tirerait
# scikit-learn, scipy et scikit-image, inutiles ici.
RUN pip install "streamlit==1.66.1" "httpx==0.28.1" "pillow==12.3.0"

COPY src/chantier_defects/ui/streamlit_app.py ./streamlit_app.py

RUN useradd --create-home --uid 1000 app
USER app

EXPOSE 8501

# CHANTIER_API_URL : URL de l'API (définie au déploiement).
CMD ["sh", "-c", "exec streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port ${PORT:-8501}"]
