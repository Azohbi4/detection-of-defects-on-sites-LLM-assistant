# Copier en .env (jamais versionné). En production : secrets Azure Container Apps / Key Vault.
ANTHROPIC_API_KEY=

# Chemin du modèle chargé au démarrage de l'API (.pt pour le CNN, .joblib pour la baseline)
CHANTIER_MODEL_PATH=models/model.pt

# Qdrant : URL du serveur (docker-compose) ou chemin local (mode embarqué)
CHANTIER_QDRANT_URL=http://localhost:6333
# CHANTIER_QDRANT_PATH=qdrant_storage

CHANTIER_LLM_MODEL=claude-opus-5-5
